# Security Log Analyzer - Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Flask Configuration
# ============================================
FLASK_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================
# ChromaDB Configuration
# ============================================
# Use service name when running in Docker
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# Use localhost when running locally
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ============================================
# Ollama Configuration
# ============================================
# Use service name when running in Docker
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=phi
OLLAMA_TIMEOUT=120
# Use localhost when running locally
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434

# ============================================
# Authentication Configuration
# ============================================
JWT_EXPIRY_HOURS=24

# ============================================
# Alerting - Webhook (Optional)
# ============================================
# Leave empty to disable webhook alerts
ALERT_WEBHOOK_URL=
WEBHOOK_TIMEOUT=5

# ============================================
# Alerting - Email (Optional)
# ============================================
# Leave empty to disable email alerts
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=30

# ============================================
# Database Configuration
# ============================================
DATABASE_PATH=data/users.db
